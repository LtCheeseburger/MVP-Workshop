<Window x:Class="MVPWorkshop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MVPWorkshop.App"
        Icon="Assets/MvpWorkshop.ico" Title="MVP-Workshop 1.0.0" Width="1560" Height="920" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{x:Static local:MainWindow.OpenFolderCmd}"/>
    <KeyBinding Key="F" Modifiers="Control" Command="{x:Static local:MainWindow.FocusSearchCmd}"/>
    <KeyBinding Key="W" Modifiers="Control" Command="{x:Static local:MainWindow.CloseTabCmd}"/>
    <KeyBinding Key="S" Modifiers="Control" Command="{x:Static local:MainWindow.SaveProjectCmd}"/>
    <KeyBinding Key="S" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.SaveProjectAsCmd}"/>
    <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static local:MainWindow.UndoCmd}"/>
    <KeyBinding Key="Y" Modifiers="Control" Command="{x:Static local:MainWindow.RedoCmd}"/>
    <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.RedoCmd}"/>
    <KeyBinding Key="E" Modifiers="Control" Command="{x:Static local:MainWindow.ExportModCmd}"/>
    <KeyBinding Key="W" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.CloseAllTabsCmd}"/>
    <KeyBinding Key="F5" Command="{x:Static local:MainWindow.TestGameCmd}"/>
  </Window.InputBindings>
  <Border x:Name="RootBorder" BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition/>
        <RowDefinition Height="26"/>
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Border Background="#101114">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <Image Source="Assets/MvpWorkshop.png" Width="80" Height="32" Stretch="Uniform" ToolTip="MVP Workshop"/>
            <TextBlock Text="MVP-Workshop" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="VersionLabel" FontWeight="SemiBold" Cursor="Hand" ToolTip="Check for updates" WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonUp="VersionLabel_Click" Foreground="{StaticResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
            <Border Background="{StaticResource AccentSoft}" CornerRadius="3" Padding="6,1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="EDITOR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
            </Border>
            <TextBlock x:Name="ProjectLabel" Text="Untitled project" Foreground="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <Border x:Name="DirtyBadge" Background="{StaticResource AccentSoft}" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock Text="UNSAVED CHANGES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
            </Border>
            <TextBlock x:Name="GameLabel" Text="No game loaded" Foreground="{StaticResource Faint}" Margin="14,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource Tool}" Width="46" Height="38" Click="Minimize" ToolTip="Minimize"><TextBlock Text="&#xE921;" Style="{StaticResource Glyph}" FontSize="10"/></Button>
            <Button Style="{StaticResource Tool}" Width="46" Height="38" Click="Maximize" ToolTip="Maximize"><TextBlock x:Name="MaxGlyph" Text="&#xE922;" Style="{StaticResource Glyph}" FontSize="10"/></Button>
            <Button x:Name="CloseButton" Style="{StaticResource Tool}" Width="46" Height="38" Click="CloseWindow" ToolTip="Close"><TextBlock Text="&#xE8BB;" Style="{StaticResource Glyph}" FontSize="10"/></Button>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1">
        <StackPanel>
          <Menu x:Name="MainMenu" Background="{StaticResource PanelBg}" Foreground="{StaticResource Text}" Padding="8,2">
            <Menu.Resources>
              <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                      <Grid>
                        <Border x:Name="Row" Background="Transparent" Padding="10,5">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="Check" Text="&#x2713;" Width="20" Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"/>
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{StaticResource Muted}" Margin="24,0,0,0"/>
                            <TextBlock x:Name="Arrow" Grid.Column="3" Text="›" Margin="14,0,0,0" Visibility="Collapsed"/>
                          </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" AllowsTransparency="True" Focusable="False">
                          <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Padding="3">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                          </Border>
                        </Popup>
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsCheckable" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Hidden"/></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader"><Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/><Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/></Trigger>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Selected}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Menu.Resources>
            <MenuItem Header="_File">
              <MenuItem Header="Open game…" Command="{x:Static local:MainWindow.OpenFolderCmd}" InputGestureText="Ctrl+O"/>
              <MenuItem Header="Open ISO…" Click="OpenIso_Click" InputGestureText=""/>
              <MenuItem Header="Open loose file…" Click="OpenFile_Click" InputGestureText=""/>
              <MenuItem Header="Open project…" Click="OpenProject_Click" InputGestureText=""/>
              <MenuItem Header="Open mod…" Click="OpenMod_Click"/>
              <MenuItem x:Name="RecentProjectsMenu" Header="Recent projects" SubmenuOpened="RecentProjects_Opened"/>
              <MenuItem Header="Save project" Command="{x:Static local:MainWindow.SaveProjectCmd}" InputGestureText="Ctrl+S"/>
              <MenuItem Header="Save project as…" Command="{x:Static local:MainWindow.SaveProjectAsCmd}" InputGestureText="Ctrl+Shift+S"/>
              <MenuItem Header="Export .mvpmod…" Command="{x:Static local:MainWindow.ExportModCmd}" InputGestureText="Ctrl+E"/>
              <MenuItem Header="Export ISO…" Click="ExportIso_Click" InputGestureText=""/>
              <MenuItem Header="Close tab" Command="{x:Static local:MainWindow.CloseTabCmd}" InputGestureText="Ctrl+W"/>
              <MenuItem Header="Close all tabs" Command="{x:Static local:MainWindow.CloseAllTabsCmd}" InputGestureText="Ctrl+Shift+W"/>
              <MenuItem Header="Exit" Click="CloseWindow" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Edit">
              <MenuItem Header="Undo" Command="{x:Static local:MainWindow.UndoCmd}" InputGestureText="Ctrl+Z"/>
              <MenuItem Header="Redo" Command="{x:Static local:MainWindow.RedoCmd}" InputGestureText="Ctrl+Y / Ctrl+Shift+Z"/>
              <MenuItem Header="Add file…" Click="AddFile_Click" InputGestureText=""/>
            </MenuItem>
            <MenuItem Header="_View">
              <MenuItem Header="Bookmarks" Click="Bookmarks_Click" InputGestureText="Ctrl+B / Ctrl+Shift+B"/>
              <MenuItem Header="Diagnostics" Click="Diagnostics_Click"/>
              <MenuItem Header="Search assets" Command="{x:Static local:MainWindow.FocusSearchCmd}" InputGestureText="Ctrl+F"/>
              <MenuItem Click="ShowChanges_Click"><MenuItem.Header><TextBlock x:Name="ChangesLabel" Text="Changes"/></MenuItem.Header></MenuItem>
              <MenuItem Header="Log" Click="LogToggle_Click" x:Name="LogToggle" IsCheckable="True" IsChecked="True" InputGestureText=""/>
              <MenuItem Header="Properties" Click="PropsToggle_Click" x:Name="PropsToggle" IsCheckable="True" IsChecked="True" InputGestureText=""/>
              <MenuItem Header="Collapse all" Click="CollapseAll_Click" InputGestureText=""/>
              <MenuItem Header="Clear log" Click="ClearLog_Click" InputGestureText=""/>
            </MenuItem>
            <MenuItem Header="_Tools">
              <MenuItem Header="Options…" Click="Options_Click"/>
              <MenuItem Header="Installed mods as base…" Click="BaseMods_Click"/>
              <MenuItem Header="Export all rosters CSV…" Click="ExportAllRosters_Click"/>
              <MenuItem Header="Import roster CSV (all schools)…" Click="ImportAllRosters_Click"/>
              <MenuItem Header="Test in Game" Command="{x:Static local:MainWindow.TestGameCmd}" InputGestureText="F5"/>
              <MenuItem Header="Export raw…" Click="ExportRaw_Click" InputGestureText=""/>
              <MenuItem Header="Extract tree…" Click="ExportFolder_Click" InputGestureText=""/>
              <MenuItem Header="Dependencies" Click="Dependencies_Click" InputGestureText=""/>
              <MenuItem Header="Format survey" Click="Survey_Click" InputGestureText=""/>
            </MenuItem>
            <MenuItem Header="_Help">
              <MenuItem Header="Check for updates…" Click="CheckUpdates_Click" InputGestureText=""/>
              <MenuItem Header="About MVP Workshop" Click="About_Click" InputGestureText=""/>
            </MenuItem>
          </Menu>
          <DockPanel Margin="8,2,8,5" LastChildFill="False">
            <StackPanel Orientation="Horizontal">
              <Button  Style="{StaticResource Tool}" Command="{x:Static local:MainWindow.OpenFolderCmd}" Content="Open" ToolTip="Open (Ctrl+O)"/>
              <Button  Style="{StaticResource Tool}" Command="{x:Static local:MainWindow.SaveProjectCmd}" Content="Save" ToolTip="Save (Ctrl+S)"/>
              <Button x:Name="UndoButton" Style="{StaticResource Tool}" Command="{x:Static local:MainWindow.UndoCmd}" Content="Undo" ToolTip="Undo (Ctrl+Z)"/>
              <Button x:Name="RedoButton" Style="{StaticResource Tool}" Command="{x:Static local:MainWindow.RedoCmd}" Content="Redo" ToolTip="Redo (Ctrl+Y)"/>
              <Button x:Name="DiagnosticsButton" Style="{StaticResource Tool}" Content="Diagnostics (0)" Click="Diagnostics_Click" ToolTip="Errors and warnings for the current project"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource Primary}" Command="{x:Static local:MainWindow.TestGameCmd}" Content="Test in Game" ToolTip="Test edits as a temporary mod (F5)" Margin="0,0,8,0"/>
              <Button Style="{StaticResource Outline}" Command="{x:Static local:MainWindow.ExportModCmd}" Content="Export .mvpmod" FontWeight="SemiBold" Foreground="{StaticResource Good}" ToolTip="Export mod (Ctrl+E)"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- Workspace -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" MinWidth="200"/>
          <ColumnDefinition Width="4"/>
          <ColumnDefinition Width="*" MinWidth="300"/>
          <ColumnDefinition x:Name="PropsSplitCol" Width="4"/>
          <ColumnDefinition x:Name="PropsCol" Width="330" MinWidth="0"/>
        </Grid.ColumnDefinitions>

        <!-- Data explorer -->
        <Border Background="{StaticResource PanelBg}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <DockPanel Margin="12,0,6,0">
              <TextBlock Text="DATA EXPLORER" Style="{StaticResource PanelHeader}"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Tool}" Padding="6,4" Click="CollapseAll_Click" ToolTip="Collapse all"><TextBlock Text="&#xE8C5;" Style="{StaticResource Glyph}" FontSize="12"/></Button>
              </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1" Margin="10,0,10,8">
              <TextBox x:Name="SearchBox" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged" Padding="26,5,6,5" ToolTip="Search every file name, including inside archives (Enter). Esc clears."/>
              <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource Faint}" Margin="9,0,0,0" IsHitTestVisible="False"/>
              <TextBlock x:Name="SearchHint" Text="Search all assets…  (Enter)" Foreground="{StaticResource Faint}" Margin="27,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <ComboBox x:Name="BrowseMode" Grid.Row="2" Margin="10,0,10,8" SelectedIndex="0" SelectionChanged="BrowseMode_SelectionChanged" ToolTip="Browse assets by purpose or original archive path">
              <ComboBoxItem Content="Categories"/><ComboBoxItem Content="Files and archives"/>
            </ComboBox>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="12,0,10,8" ToolTip="Show all assets when neither is checked; checked kinds are combined."><CheckBox x:Name="ModifiedFilter" Content="Modified" Click="ExplorerFilter_Click" Margin="0,0,16,0"/><CheckBox x:Name="AddedFilter" Content="Added" Click="ExplorerFilter_Click"/></StackPanel>
            <TreeView x:Name="Tree" Grid.Row="4" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" SelectedItemChanged="Tree_SelectedItemChanged" MouseDoubleClick="Tree_MouseDoubleClick" KeyDown="Tree_KeyDown" PreviewMouseRightButtonDown="Tree_RightButtonDown" ContextMenuOpening="Tree_ContextMenuOpening">
              <TreeView.ContextMenu><ContextMenu/></TreeView.ContextMenu>
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type local:TreeItem}" ItemsSource="{Binding Children}">
                  <Grid ToolTip="{Binding Node.Path}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="13" Foreground="{Binding GlyphBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding BaseOrigin}" Foreground="{StaticResource Muted}" Margin="6,0,0,0"/>
                      <TextBlock Text="+" Foreground="{StaticResource Good}" Margin="6,0,0,0" ToolTip="Added to this mod" Visibility="{Binding IsAdded, Converter={x:Static local:Conv.BoolToVis}}"/>
                      <TextBlock Text="&#x25CF;" Foreground="{StaticResource Accent}" FontSize="9" Margin="6,1,0,0" VerticalAlignment="Center" ToolTip="Edited in this project"
                                 Visibility="{Binding IsEdited, Converter={x:Static local:Conv.BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Meta}" Foreground="{StaticResource Faint}" FontSize="10.5" Margin="8,0,8,0" VerticalAlignment="Center"/>
                  </Grid>
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
            <Grid x:Name="SearchPanel" Grid.Row="4" Visibility="Collapsed" Background="{StaticResource PanelBg}">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
              <DockPanel Margin="12,0,8,6">
                <Button DockPanel.Dock="Right" Style="{StaticResource Tool}" Padding="6,3" Click="CloseSearch_Click" ToolTip="Back to tree"><TextBlock Text="&#xE8BB;" Style="{StaticResource Glyph}" FontSize="10"/></Button>
                <TextBlock x:Name="SearchStatus" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
              </DockPanel>
              <ListBox x:Name="SearchResults" Grid.Row="1" PreviewMouseRightButtonDown="Tree_RightButtonDown" ContextMenuOpening="Tree_ContextMenuOpening" MouseDoubleClick="SearchResults_DoubleClick" SelectionChanged="SearchResults_SelectionChanged" KeyDown="SearchResults_KeyDown">
                <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ToolTip="{Binding Path}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding FormatInfo.Glyph}" Style="{StaticResource Glyph}" FontSize="13" Foreground="{StaticResource Muted}"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Path}" Foreground="{StaticResource Faint}" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </Grid>

                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
            <DockPanel x:Name="BookmarkPane" Grid.Row="4" Visibility="Collapsed" Background="{StaticResource PanelBg}">
              <StackPanel DockPanel.Dock="Top" Margin="10">
                <Button Content="Back to explorer" Click="CloseBookmarks_Click"/>
                <TextBox x:Name="BookmarkSearch" Margin="0,8,0,0" ToolTip="Filter bookmarks by name or folder" TextChanged="BookmarkSearch_Changed"/>
              </StackPanel>
              <TreeView x:Name="BookmarkTree"/>
            </DockPanel>
          </Grid>
        </Border>
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

        <!-- Documents + log -->
        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="200"/>
            <RowDefinition x:Name="LogSplitRow" Height="4"/>
            <RowDefinition x:Name="LogRow" Height="170" MinHeight="0"/>
          </Grid.RowDefinitions>
          <TabControl x:Name="Docs" Tag="{StaticResource PanelBg}" SelectionChanged="Docs_SelectionChanged" Background="{StaticResource WindowBg}">
            <TabControl.ItemContainerStyle>
              <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Tab_MouseDown"/>
                <EventSetter Event="PreviewMouseMove" Handler="Tab_MouseMove"/>
                <EventSetter Event="DragOver" Handler="Tab_DragOver"/>
                <EventSetter Event="Drop" Handler="Tab_Drop"/>
                <Setter Property="AllowDrop" Value="True"/>
              </Style>
            </TabControl.ItemContainerStyle>
            <TabControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:DocumentTab}">
                <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                  <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,7,0"/>
                  <TextBlock Text="{Binding Title}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <TextBlock Text="+" Foreground="{StaticResource Good}" Margin="6,0,0,0" ToolTip="Added to this mod" Visibility="{Binding IsAdded, Converter={x:Static local:Conv.BoolToVis}}"/>
                      <TextBlock Text="&#x25CF;" Foreground="{StaticResource Accent}" FontSize="9" Margin="6,1,0,0" VerticalAlignment="Center" ToolTip="{Binding EditedTip}"
                             Visibility="{Binding IsEdited, Converter={x:Static local:Conv.BoolToVis}}"/>
                  <Button Style="{StaticResource Tool}" Padding="4,2" Margin="8,-2,-6,-2" Click="CloseTab_Click" Tag="{Binding}"
                          Visibility="{Binding CanClose, Converter={x:Static local:Conv.BoolToVis}}" ToolTip="Close (Ctrl+W)">
                    <TextBlock Text="&#xE8BB;" Style="{StaticResource Glyph}" FontSize="8"/>
                  </Button>
                </StackPanel>
              </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
              <DataTemplate DataType="{x:Type local:DocumentTab}">
                <ContentPresenter Content="{Binding Content}"/>
              </DataTemplate>
            </TabControl.ContentTemplate>
          </TabControl>
          <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch"/>
          <Border Grid.Row="2" Background="{StaticResource PanelBg}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/></Grid.RowDefinitions>
              <DockPanel Margin="12,0,6,0">
                <TextBlock Text="LOG" Style="{StaticResource PanelHeader}"/>
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource Tool}" Padding="6,2" Click="ClearLog_Click" ToolTip="Clear log"><TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="11"/></Button>
              </DockPanel>
              <ListBox x:Name="LogList" Grid.Row="1" FontFamily="{StaticResource Mono}" FontSize="11.5">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="10,1"/></Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Stamp}" Foreground="{StaticResource Faint}"/>
                      <TextBlock Text="{Binding Level}" Width="52" Margin="10,0,0,0" Foreground="{Binding Level, Converter={x:Static local:Conv.LevelBrush}}"/>
                      <TextBlock Text="{Binding Text}"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
        <GridSplitter x:Name="PropsSplitter" Grid.Column="3" HorizontalAlignment="Stretch"/>

        <!-- Properties -->
        <Border x:Name="PropsPanel" Grid.Column="4" Background="{StaticResource PanelBg}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="PROPERTIES" Style="{StaticResource PanelHeader}" Margin="14,0,0,0"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="PropsList" Margin="0,0,0,12">
                <ItemsControl.GroupStyle>
                  <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                      <DataTemplate>
                        <Border Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="0,1" Padding="14,5" Margin="0,6,0,2">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" FontSize="11.5"/>
                        </Border>
                      </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                  </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="14,3,12,3">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Key}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}"/>
                      <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- Status bar -->
      <Border Grid.Row="3" Background="#101114" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
        <DockPanel Margin="12,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="StatusRight" Foreground="{StaticResource Faint}"/>
            <Ellipse Width="7" Height="7" Fill="{StaticResource Good}" Margin="10,0,0,0"/>
          </StackPanel>
          <TextBlock x:Name="Status" Text="Ready" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
