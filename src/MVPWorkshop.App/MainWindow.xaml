<Window x:Class="MVPWorkshop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MVPWorkshop.App"
        Icon="Assets/MvpWorkshop.ico" Title="MVP-Workshop 1.0.0" Width="1560" Height="920" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{x:Static local:MainWindow.OpenFolderCmd}"/>
    <KeyBinding Key="F" Modifiers="Control" Command="{x:Static local:MainWindow.FocusSearchCmd}"/>
    <KeyBinding Key="W" Modifiers="Control" Command="{x:Static local:MainWindow.CloseTabCmd}"/>
    <KeyBinding Key="S" Modifiers="Control" Command="{x:Static local:MainWindow.SaveProjectCmd}"/>
    <KeyBinding Key="S" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.SaveProjectAsCmd}"/>
    <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static local:MainWindow.UndoCmd}"/>
    <KeyBinding Key="Y" Modifiers="Control" Command="{x:Static local:MainWindow.RedoCmd}"/>
    <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.RedoCmd}"/>
    <KeyBinding Key="E" Modifiers="Control" Command="{x:Static local:MainWindow.ExportModCmd}"/>
  </Window.InputBindings>
  <Border x:Name="RootBorder" BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38"/>
        <RowDefinition Height="42"/>
        <RowDefinition/>
        <RowDefinition Height="26"/>
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Border Background="#101114">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <Image Source="Assets/MvpWorkshop.png" Width="80" Height="32" Stretch="Uniform" ToolTip="MVP Workshop"/>
            <TextBlock Text="MVP-Workshop" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="VersionLabel" FontWeight="SemiBold" Cursor="Hand" ToolTip="Check for updates" WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonUp="VersionLabel_Click" Foreground="{StaticResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
            <Border Background="{StaticResource AccentSoft}" CornerRadius="3" Padding="6,1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="EDITOR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
            </Border>
            <TextBlock x:Name="ProjectLabel" Text="Untitled project" Foreground="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <Border x:Name="DirtyBadge" Background="{StaticResource AccentSoft}" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock Text="UNSAVED CHANGES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
            </Border>
            <TextBlock x:Name="GameLabel" Text="No game loaded" Foreground="{StaticResource Faint}" Margin="14,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource Tool}" Width="46" Height="38" Click="Minimize" ToolTip="Minimize"><TextBlock Text="&#xE921;" Style="{StaticResource Glyph}" FontSize="10"/></Button>
            <Button Style="{StaticResource Tool}" Width="46" Height="38" Click="Maximize" ToolTip="Maximize"><TextBlock x:Name="MaxGlyph" Text="&#xE922;" Style="{StaticResource Glyph}" FontSize="10"/></Button>
            <Button x:Name="CloseButton" Style="{StaticResource Tool}" Width="46" Height="38" Click="CloseWindow" ToolTip="Close"><TextBlock Text="&#xE8BB;" Style="{StaticResource Glyph}" FontSize="10"/></Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Toolbar -->
      <Border Grid.Row="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1">
        <DockPanel Margin="8,0" LastChildFill="False">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource Tool}" Click="OpenFolder_Click" ToolTip="Open the installed game: select its MVP06.exe (Ctrl+O)">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" Foreground="{StaticResource Accent}"/><TextBlock Text="Open Game" Margin="7,0,0,0"/></StackPanel>
            </Button>
            <Button Style="{StaticResource Tool}" Click="OpenIso_Click" ToolTip="Open an ISO9660 disc image for project editing">
              <TextBlock Text="Open ISO"/>
            </Button>
            <Button Style="{StaticResource Tool}" Click="OpenFile_Click" ToolTip="Open a single loose file">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource Glyph}"/><TextBlock Text="Open File" Margin="7,0,0,0"/></StackPanel>
            </Button>
            <Border Width="1" Background="{StaticResource Line}" Margin="8,9"/>
            <Button Style="{StaticResource Tool}" Click="OpenProject_Click" ToolTip="Open an editing project (.mvpwproj; legacy .mvp07proj also opens)">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8DA;" Style="{StaticResource Glyph}"/><TextBlock Text="Open Project" Margin="7,0,0,0"/></StackPanel>
            </Button>
            <Button Style="{StaticResource Tool}" Click="SaveProject_Click" ToolTip="Save the project: edited assets and notes (Ctrl+S). Does not touch game files.">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource Glyph}" Foreground="{StaticResource Accent}"/><TextBlock Text="Save Project" Margin="7,0,0,0"/></StackPanel>
            </Button>
            <Button x:Name="UndoButton" Style="{StaticResource Tool}" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)" IsEnabled="False">
              <TextBlock Text="&#xE7A7;" Style="{StaticResource Glyph}"/>
            </Button>
            <Button x:Name="RedoButton" Style="{StaticResource Tool}" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)" IsEnabled="False">
              <TextBlock Text="&#xE7A6;" Style="{StaticResource Glyph}"/>
            </Button>
            <Button Style="{StaticResource Tool}" Click="ShowChanges_Click" ToolTip="Every pending change, saved or preview-only">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource Glyph}"/><TextBlock x:Name="ChangesLabel" Text="Changes" Margin="7,0,0,0"/></StackPanel>
            </Button>
            <Button Style="{StaticResource Tool}" Click="ExportMod_Click" ToolTip="Loose install: pack your edits as a .mvpmod for the launcher. Disc or packed folder: rebuild the edited archives into the mod output folder (Ctrl+E). Original game files are never modified.">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" Foreground="{StaticResource Good}"/><TextBlock Text="Export Mod" Margin="7,0,0,0"/></StackPanel>
            </Button>
            <Button Style="{StaticResource Tool}" Click="AddFile_Click" ToolTip="Add a new file to the mod, in the selected folder or archive of the loose install (a new member, texture pack or other file). Listed under Changes.">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Glyph}"/><TextBlock Text="Add File" Margin="7,0,0,0"/></StackPanel>
            </Button>
            <Button Style="{StaticResource Tool}" Click="TestMod_Click" ToolTip="Start the installed game with your edits as a temporary mod (loose installs). Nothing is installed or changed.">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Glyph}"/><TextBlock Text="Test in Game" Margin="7,0,0,0"/></StackPanel>
            </Button>
            <Border Width="1" Background="{StaticResource Line}" Margin="8,9"/>
            <Button Style="{StaticResource Tool}" Click="ExportIso_Click" ToolTip="Export edits to a new ISO image; extracted projects use an original ISO layout template">
              <TextBlock Text="Export ISO"/>
            </Button>
            <Button Style="{StaticResource Tool}" Click="ExportRaw_Click" ToolTip="Save the selected asset's bytes (decompressed) to disk">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDE1;" Style="{StaticResource Glyph}"/><TextBlock Text="Export Raw" Margin="7,0,0,0"/></StackPanel>
            </Button>
            <Button Style="{StaticResource Tool}" Click="ExportFolder_Click" ToolTip="Extract the selected folder/archive (recursively) to disk">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}"/><TextBlock Text="Extract Tree" Margin="7,0,0,0"/></StackPanel>
            </Button>
            <Border Width="1" Background="{StaticResource Line}" Margin="8,9"/>
            <Button Style="{StaticResource Tool}" Click="Dependencies_Click" Content="Dependencies" ToolTip="Depends on, Used by, missing references and replacement impact"/>
            <Button Style="{StaticResource Tool}" Click="Survey_Click" ToolTip="Walk every file and archive, identify formats, and test the parsers">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" Foreground="{StaticResource Good}"/><TextBlock Text="Format Survey" Margin="7,0,0,0"/></StackPanel>
            </Button>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <ToggleButton x:Name="LogToggle" Style="{StaticResource Segment}" IsChecked="True" Click="LogToggle_Click" ToolTip="Show/hide the log">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D5;" Style="{StaticResource Glyph}" FontSize="12"/><TextBlock Text="Log" Margin="6,0,0,0"/></StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="PropsToggle" Style="{StaticResource Segment}" IsChecked="True" Click="PropsToggle_Click" ToolTip="Show/hide properties" Margin="0,0,4,0">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="12"/><TextBlock Text="Properties" Margin="6,0,0,0"/></StackPanel>
            </ToggleButton>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Workspace -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" MinWidth="200"/>
          <ColumnDefinition Width="4"/>
          <ColumnDefinition Width="*" MinWidth="300"/>
          <ColumnDefinition x:Name="PropsSplitCol" Width="4"/>
          <ColumnDefinition x:Name="PropsCol" Width="330" MinWidth="0"/>
        </Grid.ColumnDefinitions>

        <!-- Data explorer -->
        <Border Background="{StaticResource PanelBg}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <DockPanel Margin="12,0,6,0">
              <TextBlock Text="DATA EXPLORER" Style="{StaticResource PanelHeader}"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Tool}" Padding="6,4" Click="CollapseAll_Click" ToolTip="Collapse all"><TextBlock Text="&#xE8C5;" Style="{StaticResource Glyph}" FontSize="12"/></Button>
              </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1" Margin="10,0,10,8">
              <TextBox x:Name="SearchBox" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged" Padding="26,5,6,5" ToolTip="Search every file name, including inside archives (Enter). Esc clears."/>
              <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource Faint}" Margin="9,0,0,0" IsHitTestVisible="False"/>
              <TextBlock x:Name="SearchHint" Text="Search all assets…  (Enter)" Foreground="{StaticResource Faint}" Margin="27,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <ComboBox x:Name="BrowseMode" Grid.Row="2" Margin="10,0,10,8" SelectedIndex="0" SelectionChanged="BrowseMode_SelectionChanged" ToolTip="Browse assets by purpose or original archive path">
              <ComboBoxItem Content="Categories"/><ComboBoxItem Content="Files and archives"/>
            </ComboBox>
            <TreeView x:Name="Tree" Grid.Row="3" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" SelectedItemChanged="Tree_SelectedItemChanged" MouseDoubleClick="Tree_MouseDoubleClick" KeyDown="Tree_KeyDown" PreviewMouseRightButtonDown="Tree_RightButtonDown" ContextMenuOpening="Tree_ContextMenuOpening">
              <TreeView.ContextMenu><ContextMenu/></TreeView.ContextMenu>
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type local:TreeItem}" ItemsSource="{Binding Children}">
                  <Grid ToolTip="{Binding Node.Path}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="13" Foreground="{Binding GlyphBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      <TextBlock Text="&#x25CF;" Foreground="{StaticResource Accent}" FontSize="9" Margin="6,1,0,0" VerticalAlignment="Center" ToolTip="Edited in this project"
                                 Visibility="{Binding IsEdited, Converter={x:Static local:Conv.BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Meta}" Foreground="{StaticResource Faint}" FontSize="10.5" Margin="8,0,8,0" VerticalAlignment="Center"/>
                  </Grid>
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
            <Grid x:Name="SearchPanel" Grid.Row="3" Visibility="Collapsed" Background="{StaticResource PanelBg}">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
              <DockPanel Margin="12,0,8,6">
                <Button DockPanel.Dock="Right" Style="{StaticResource Tool}" Padding="6,3" Click="CloseSearch_Click" ToolTip="Back to tree"><TextBlock Text="&#xE8BB;" Style="{StaticResource Glyph}" FontSize="10"/></Button>
                <TextBlock x:Name="SearchStatus" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
              </DockPanel>
              <ListBox x:Name="SearchResults" Grid.Row="1" MouseDoubleClick="SearchResults_DoubleClick" SelectionChanged="SearchResults_SelectionChanged" KeyDown="SearchResults_KeyDown">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ToolTip="{Binding Path}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding FormatInfo.Glyph}" Style="{StaticResource Glyph}" FontSize="13" Foreground="{StaticResource Muted}"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Path}" Foreground="{StaticResource Faint}" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Grid>
        </Border>
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

        <!-- Documents + log -->
        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="200"/>
            <RowDefinition x:Name="LogSplitRow" Height="4"/>
            <RowDefinition x:Name="LogRow" Height="170" MinHeight="0"/>
          </Grid.RowDefinitions>
          <TabControl x:Name="Docs" Tag="{StaticResource PanelBg}" SelectionChanged="Docs_SelectionChanged" Background="{StaticResource WindowBg}">
            <TabControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:DocumentTab}">
                <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                  <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,7,0"/>
                  <TextBlock Text="{Binding Title}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <TextBlock Text="&#x25CF;" Foreground="{StaticResource Accent}" FontSize="9" Margin="6,1,0,0" VerticalAlignment="Center" ToolTip="{Binding EditedTip}"
                             Visibility="{Binding IsEdited, Converter={x:Static local:Conv.BoolToVis}}"/>
                  <Button Style="{StaticResource Tool}" Padding="4,2" Margin="8,-2,-6,-2" Click="CloseTab_Click" Tag="{Binding}"
                          Visibility="{Binding CanClose, Converter={x:Static local:Conv.BoolToVis}}" ToolTip="Close (Ctrl+W)">
                    <TextBlock Text="&#xE8BB;" Style="{StaticResource Glyph}" FontSize="8"/>
                  </Button>
                </StackPanel>
              </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
              <DataTemplate DataType="{x:Type local:DocumentTab}">
                <ContentPresenter Content="{Binding Content}"/>
              </DataTemplate>
            </TabControl.ContentTemplate>
          </TabControl>
          <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch"/>
          <Border Grid.Row="2" Background="{StaticResource PanelBg}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/></Grid.RowDefinitions>
              <DockPanel Margin="12,0,6,0">
                <TextBlock Text="LOG" Style="{StaticResource PanelHeader}"/>
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource Tool}" Padding="6,2" Click="ClearLog_Click" ToolTip="Clear log"><TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="11"/></Button>
              </DockPanel>
              <ListBox x:Name="LogList" Grid.Row="1" FontFamily="{StaticResource Mono}" FontSize="11.5">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="10,1"/></Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Stamp}" Foreground="{StaticResource Faint}"/>
                      <TextBlock Text="{Binding Level}" Width="52" Margin="10,0,0,0" Foreground="{Binding Level, Converter={x:Static local:Conv.LevelBrush}}"/>
                      <TextBlock Text="{Binding Text}"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
        <GridSplitter x:Name="PropsSplitter" Grid.Column="3" HorizontalAlignment="Stretch"/>

        <!-- Properties -->
        <Border x:Name="PropsPanel" Grid.Column="4" Background="{StaticResource PanelBg}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="PROPERTIES" Style="{StaticResource PanelHeader}" Margin="14,0,0,0"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="PropsList" Margin="0,0,0,12">
                <ItemsControl.GroupStyle>
                  <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                      <DataTemplate>
                        <Border Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="0,1" Padding="14,5" Margin="0,6,0,2">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" FontSize="11.5"/>
                        </Border>
                      </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                  </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="14,3,12,3">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Key}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}"/>
                      <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- Status bar -->
      <Border Grid.Row="3" Background="#101114" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
        <DockPanel Margin="12,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="StatusRight" Foreground="{StaticResource Faint}"/>
            <Ellipse Width="7" Height="7" Fill="{StaticResource Good}" Margin="10,0,0,0"/>
          </StackPanel>
          <TextBlock x:Name="Status" Text="Ready" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
