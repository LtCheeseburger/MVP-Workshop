+void FillNetworkInfo(uint32_t out, uint64_t t, uint64_t size, bool dir) {
+    for (int i = 0; i < 4; i++) W64(out + i * 8, t);
+    W64(out + 0x20, (size + 0xFFF) & ~0xFFFull);
+    W64(out + 0x28, size);
+    W32(out + 0x30, dir ? 0x10 : 0x80);  // FILE_ATTRIBUTE_DIRECTORY or NORMAL
