+std::string Upper(std::string s) {
+    for (char& c : s) c = char(std::toupper(uint8_t(c)));
+    return s;
+}
+
+std::string Normalize(std::string p) {
+    std::replace(p.begin(), p.end(), '/', '\\');
+    std::string out;
+    for (char c : p) {
+        if (c == '\\' && !out.empty() && out.back() == '\\') continue;
+        out += c;
+    }
+    while (out.size() > 1 && out.back() == '\\') out.pop_back();
+    return out;
+}
