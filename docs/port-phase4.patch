-long JsonNumber(const std::string& s, const char* key, long fallback) {
-    size_t p = s.find("\"" + std::string(key) + "\"");
-    if (p == std::string::npos || (p = s.find(':', p)) == std::string::npos) return fallback;
-    return std::strtol(s.c_str() + p + 1, nullptr, 10);
