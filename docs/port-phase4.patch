+    g_devices[kCdRom] = game_dir;
+    g_devices["\\DEVICE\\HARDDISK0\\PARTITION1"] = d / "E";
+    g_devices["\\DEVICE\\HARDDISK0\\PARTITION2"] = d / "C";
+    g_devices["\\DEVICE\\HARDDISK0\\PARTITION3"] = d / "X";
+    g_devices["\\DEVICE\\HARDDISK0\\PARTITION4"] = d / "Y";
