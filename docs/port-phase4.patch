-    f->host = mods::FromMod(host) ? fs::path(host) : modvfs::LooseFolder(host);  // for its times
-    f->xbox = Normalize(name);
-    f->vf = vf;
-    W32(handle_out, NewHandle(f));
-    IoStatus(iosb, kSuccess, 1);
-    LOG_FIRST(400, "open %s (loose)", name.c_str());
