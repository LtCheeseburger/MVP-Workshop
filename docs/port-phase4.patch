+
+std::string ResolvePath(const std::string& xbox_path, uint32_t root_handle) { return Resolve(xbox_path, root_handle).host; }
+
+bool ReadGameFile(const std::string& xbox_path, std::vector<uint8_t>& out) {
+    Target t = Resolve(xbox_path, 0);
+    if (t.disc) {
+        if (!t.entry || t.entry->dir) return false;
+        out.resize(t.entry->size);
+        return MountedDisc()->Read(*t.entry, 0, out.data(), t.entry->size) == t.entry->size;
+    }
+    if (t.host.empty()) return false;
+    if (!mods::FromMod(t.host) && mods::Load(t.host, out)) return true;
+    auto vf = modvfs::OpenLoose(t.host);
+    if (!vf) return false;
+    out.resize(vf->Size());
+    return vf->Read(0, out.data(), out.size()) == out.size();
+}
+
+// an archive installed as a loose folder: read only, served by modvfs
+static uint32_t OpenLoose(const std::string& host, const std::string& name, uint32_t handle_out, uint32_t iosb) {
+    auto vf = modvfs::OpenLoose(host);
+    if (!vf) {
+        LOG_FIRST(200, "missing %s", name.c_str());
+        IoStatus(iosb, kObjectNameNotFound, 5);
+        return kObjectNameNotFound;
+    }
+    auto f = std::make_shared<File>();
+    f->host = mods::FromMod(host) ? fs::path(host) : modvfs::LooseFolder(host);  // for its times
+    f->xbox = Normalize(name);
+    f->vf = vf;
+    W32(handle_out, NewHandle(f));
+    IoStatus(iosb, kSuccess, 1);
+    LOG_FIRST(400, "open %s (loose)", name.c_str());
+    return kSuccess;
+}
